# systemd unit for a VPS. Edit User and WorkingDirectory, then:
#   sudo cp deploy/memedesk.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now memedesk
#   journalctl -u memedesk -f
[Unit]
Description=memedesk Solana memecoin desk
After=network-online.target
Wants=network-online.target

[Service]
User=desk
WorkingDirectory=/home/desk/Trading
ExecStart=/usr/bin/python3 -m memedesk run
Restart=on-failure
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
