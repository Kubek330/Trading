# memedesk is paper-only. Every setting below is optional; these are the defaults.

DESK_PROFILE=active              # active (default): trades more · strict: original spec, every unknown kills
DESK_PAPER_START_USD=1000        # per book: "scored" and "random" each start with this

# ---- grok (optional): second opinion on 70+ setups + written reports
XAI_API_KEY=
DESK_GROK_MODEL=grok-4
DESK_GROK_VETO=false

# ---- telegram (optional): entries, take-profits, exits, 6-hourly reports
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- extra data keys (all free, all optional)
JUP_API_KEY=                     # portal.jup.ag: Jupiter organic score (anti wash-trading filter)
COINGECKO_API_KEY=               # CoinGecko Demo: used ONLY as backup when GeckoTerminal returns 429
DESK_COINGECKO_MONTHLY_CAP=9500  # Demo plan = 10,000 calls/month; the bot stops using it at this count

# ---- whale scout
HELIUS_API_KEY=                  # optional; much faster early-buyer reads. Without it: public RPC, small budgets
DESK_WHALE_SCOUT=true
DESK_WHALE_INTERVAL_MIN=30
DESK_WHALE_MIN_MULTIPLE=5
DESK_WHALE_LOOKBACK_D=7
DESK_WHALE_TOP_N=50
DESK_WHALE_MIN_WINNERS=2         # wallet must have bought >= 2 different winners early
DESK_WHALE_INACTIVE_DAYS=7
DESK_WHALE_BOT_TRADES_PER_H=50
DESK_WHALE_MODE=true             # 2+ tracked wallets buy the same token within 10 min -> Filter
DESK_WHALE_SIGNAL_WALLETS=2
DESK_WHALE_SIGNAL_WINDOW_MIN=10
# budgets (0 = auto: Helius 20 winners/run, 200 swaps, 40k sigs, poll 60s | public 3, 80, 6k, 180s)
DESK_WHALE_TOKENS_PER_RUN=0
DESK_WHALE_EARLY_SWAPS=0
DESK_WHALE_MAX_SIG_PAGES=0
DESK_WHALE_WATCH_INTERVAL_S=0

# ---- data: free public endpoints by default, paced + cached + backoff on 429
DESK_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DESK_RPC_RPM=40

# ---- scout
DESK_MIN_AGE_MIN=30
DESK_MAX_AGE_H=72
DESK_MIN_MCAP=300000
DESK_MAX_MCAP=20000000

# ---- filter (kills)
DESK_MAX_TOP10_PCT=25            # top-10 holders, pool/AMM accounts excluded
DESK_MIN_LIQ_MCAP_PCT=5
DESK_MIN_LP_LOCKED_PCT=95
DESK_MAX_DEV_PCT=3
DESK_MAX_BUNDLE_PCT=10
DESK_MAX_H1_CHANGE_PCT=80
DESK_FAIL_CLOSED=true            # missing safety data = kill
DESK_MIN_ORGANIC_SCORE=30        # Jupiter organicScore 0-100; below = kill (0 turns the filter off)
DESK_ORGANIC_FAIL_CLOSED=false   # Jupiter has no score for a token -> kill it?

# ---- analyst
# DESK_MIN_SCORE=60              # profile default: 60 (active) / 70 (strict)

# ---- random control (luck baseline, skips the analyst)
DESK_RANDOM_CONTROL=true
DESK_RANDOM_SEED=0               # 0 = time-based; set a number to make a night reproducible

# ---- executor
DESK_POSITION_PCT=8              # hard-capped at 8 in code
DESK_SLIPPAGE_BPS=200            # paper haircut each way
DESK_PAPER_FEE_BPS=50            # paper fee each way

# ---- risk (same exits for both books)
DESK_STOP_PCT=15
DESK_TP_TRIGGER_PCT=35
DESK_TP_SELL_PCT=75
DESK_RUNNER_TRAIL_PCT=35
DESK_RUNNER_FLOOR_AT_ENTRY=true
DESK_MAX_HOLD_H=48
DESK_MAX_OPEN_POSITIONS=5
DESK_DAILY_LOSS_LIMIT_PCT=20

# ---- loop & dashboard
DESK_SCAN_INTERVAL_S=120
DESK_MONITOR_INTERVAL_S=15
DESK_DASHBOARD_PORT=8084
DESK_DASHBOARD_HOST=127.0.0.1    # keep local; don't expose it to your Wi-Fi
