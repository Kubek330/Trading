# ---------------- mode ----------------
DESK_MODE=paper                 # paper | live
DESK_PAPER_START_USD=1000
# Live trading needs ALL of these. Paper first.
# DESK_MODE=live
# DESK_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY
# DESK_WALLET_KEYPAIR_PATH=~/.config/solana/desk-hot-wallet.json

# ---------------- grok (optional) ----------------
XAI_API_KEY=                    # second opinion on 70+ setups + Grok-written reports
DESK_GROK_MODEL=grok-4
DESK_GROK_VETO=false            # true = Grok can veto a 70+ setup (never forces a buy)

# ---------------- telegram (optional) ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------- data ----------------
# The public RPC rate-limits hard. A Helius/Triton/QuickNode URL is strongly recommended.
DESK_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---------------- scout ----------------
DESK_MIN_AGE_MIN=30
DESK_MAX_AGE_H=72
DESK_MIN_MCAP=300000
DESK_MAX_MCAP=20000000

# ---------------- filter (kills) ----------------
DESK_MIN_LP_LOCKED_PCT=95
DESK_MIN_LIQ_MCAP_PCT=25        # kill if liquidity < 25% of mcap
DESK_MAX_DEV_PCT=3
DESK_MAX_BUNDLE_PCT=10
DESK_MAX_H1_CHANGE_PCT=80
DESK_FAIL_CLOSED=true           # missing safety data = kill

# ---------------- analyst ----------------
DESK_MIN_SCORE=70

# ---------------- executor ----------------
DESK_POSITION_PCT=8             # hard-capped at 8 in code
DESK_MAX_POOL_IMPACT_PCT=1
DESK_SLIPPAGE_BPS=300

# ---------------- risk ----------------
DESK_STOP_PCT=6
DESK_TRAIL_ACTIVATE_PCT=12
DESK_TRAIL_PCT=6
DESK_MAX_OPEN_POSITIONS=5
DESK_DAILY_LOSS_LIMIT_PCT=15
DESK_MAX_HOLD_H=48

# ---------------- loop ----------------
DESK_SCAN_INTERVAL_S=90
DESK_MONITOR_INTERVAL_S=10
DESK_REPORT_EVERY_H=6
